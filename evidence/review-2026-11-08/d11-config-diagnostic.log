        "./lib/connection.ts",
        "./lib/receipt.ts",
        "./tests/receipt.test.ts",
        "./tests/wallet-context.test.ts",
        "./app/layout.tsx",
        "./app/page.tsx"
    ],
    "include": [
        "next-env.d.ts",
        ".next/types/**/*.ts",
        "**/*.ts",
        "**/*.tsx"
    ],
    "exclude": [
        "node_modules"
    ]
}

